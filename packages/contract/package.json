{
  "name": "@camerihq/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared zod schemas and types for the Cameri ingest API",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./ci": {
      "types": "./src/ci.ts",
      "default": "./src/ci.ts"
    }
  },
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
